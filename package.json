{
  "name": "drader",
  "version": "2.0.0",
  "description": "Drader Game Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.drader.launcher",
    "productName": "Drader",
    "win": {
      "target": "nsis",
      "icon": "icons/icon.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}
